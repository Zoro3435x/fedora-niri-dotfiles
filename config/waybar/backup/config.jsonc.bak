
 {
    "layer": "top",
    "position": "top",
    "height": 38,

    "margin-top": 8,
    "margin-left": 12,
    "margin-right": 12,

    "spacing": 8,

    "modules-left": [
        "niri/workspaces",
        "niri/window"
    ],

    "modules-center": [
        "clock"
    ],

    "modules-right": [
        "network",
        "cpu",
        "memory",
        "battery",
        "tray"
    ],

    "niri/workspaces": {
     "format": "{icon}",
     "format-icons": {
        "1": "󰆍",
        "2": "󰖟",
        "3": "󰆼",
        "4": "󰈙",
        "5": "󰒓",
        "default": "󰣇"
    }
   },
 

    "niri/window": {
        "max-length": 60
    },

    "clock": {
        "format": "󱑂 {:%H:%M}",
        "tooltip-format": "<big>{:%A %d %B %Y}</big>"
    },

    "cpu": {
        "format": " {usage}%",
        "tooltip": false
    },

    "memory": {
        "format": " {}%"
    },

    "network": {
        "format-wifi": "󰖩 {essid}",
        "format-ethernet": "󰈀 LAN",
        "format-disconnected": "󰖪 Offline"
    },

    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": "󱐋 {capacity}%",
        "format-icons": [
            "󰁺",
            "󰁼",
            "󰁾",
            "󰂀",
            "󰁹"
        ]
    }
}
