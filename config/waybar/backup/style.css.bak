* {
    font-family: "JetBrainsMono Nerd Font";
    font-size: 13px;
    font-weight: 600;
    border: none;
    min-height: 0;
}

window#waybar {
    background: rgba(17, 17, 27, 0.55);
    color: #cdd6f4;
    border-radius: 16px;
    border: 1px solid rgba(203, 166, 247, 0.20);
}

#workspaces,
#clock,
#cpu,
#memory,
#network,
#battery,
#tray,
#window {
    background: rgba(30, 30, 46, 0.78);
    border: 1px solid rgba(203, 166, 247, 0.18);
    border-radius: 14px;
    padding: 0 12px;
    margin: 5px 3px;
}

#workspaces {
    padding: 3px 6px;
}

#workspaces button {
    color: #6c7086;
    background: transparent;
    border-radius: 10px;
    padding: 0 9px;
    margin: 0 2px;
}

#workspaces button.active {
    color: #1e1e2e;
    background: #cba6f7;
}

#workspaces button:hover {
    color: #cdd6f4;
    background: rgba(203, 166, 247, 0.25);
}

#window {
    color: #bac2de;
}

#clock {
    color: #cba6f7;
    font-weight: 700;
}

#cpu {
    color: #89b4fa;
}

#memory {
    color: #a6e3a1;
}

#network {
    color: #89dceb;
}

#battery {
    color: #f9e2af;
}

#battery.warning {
    color: #fab387;
}

#battery.critical {
    color: #f38ba8;
}
