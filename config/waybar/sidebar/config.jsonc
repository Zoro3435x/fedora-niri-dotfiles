{
    "layer": "top",
    "position": "right",
    "width": 180,

    "margin-top": 64,
    "margin-bottom": 16,
    "margin-right": 12,

    "spacing": 8,

    "modules-left": [
    "custom/avatar",
    "clock",
    "custom/system-label",
    "cpu",
    "memory",
    "temperature",
    "custom/connect-label",
    "network",
    "pulseaudio",
    "custom/actions-label",
    "custom/quick-settings",
    "custom/network-settings",
    "custom/clipboard",
    "custom/btop",
    "custom/lock",
    "custom/power"
    ],

    "modules-center": [],

    "modules-right": [],

    "custom/avatar": {
        "format": "󰣇\nNiri",
        "tooltip": false
    },

    "clock": {
        "format": "{:%H:%M\n%d %b}",
        "tooltip": true,
        "tooltip-format": "{:%A %d %B %Y}",
        "on-click": "/home/zoro3435x/.config/waybar/scripts/calendar-popup.sh"
    },

    "custom/system-label": {
        "format": "SYS",
        "tooltip": false
    },

    "cpu": {
        "format": "\n{usage}%",
        "tooltip": false,
        "interval": 2
    },

    "memory": {
        "format": "\n{}%",
        "tooltip": false,
        "interval": 2
    },

    "temperature": {
        "format": "\n{temperatureC}°",
        "critical-threshold": 80,
        "tooltip": false
    },

    "custom/connect-label": {
        "format": "NET",
        "tooltip": false
    },

    "network": {
        "format-wifi": "󰖩\nWiFi",
        "format-ethernet": "󰈀\nLAN",
        "format-disconnected": "󰖪\nOff",
        "tooltip": false,
        "on-click": "/home/zoro3435x/.config/waybar/scripts/network-menu.sh",
        "on-click-right": "nm-connection-editor" 
    },

    "pulseaudio": {
        "format": "\n{volume}%",
        "format-muted": "\nMute",
        "tooltip": false,
        "scroll-step": 5,
        "on-click": "pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+ -l 1.0",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
    },
    "custom/avatar": {
      "format": "󰣇  Niri",
      "tooltip": false
    },

  "clock": {
      "format": "{:%H:%M  |  %d %b}",
      "tooltip": true,
      "tooltip-format": "{:%A %d %B %Y}",
      "on-click": "/home/zoro3435x/.config/waybar/scripts/calendar-popup.sh"
  },

  "custom/system-label": {
     "format": "SISTEMA",
     "tooltip": false
  },

  "cpu": {
     "format": " CPU  {usage}%",
     "tooltip": false,
     "interval": 2
  },

  "memory": {
     "format": " RAM  {}%",
     "tooltip": false,
     "interval": 2
  },

  "temperature": {
     "format": " TEMP {temperatureC}°",
     "critical-threshold": 80,
     "tooltip": false
  },

  "custom/connect-label": {
     "format": "CONEXIÓN",
     "tooltip": false
  },

  "network": {
     "format-wifi": "󰖩 WiFi",
     "format-ethernet": "󰈀 LAN",
     "format-disconnected": "󰖪 Off",
     "tooltip": false,
     "on-click": "/home/zoro3435x/.config/waybar/scripts/network-menu.sh",
     "on-click-right": "nm-connection-editor"
  },
  
  "pulseaudio": {
     "format": " VOL  {volume}%",
     "format-muted": " Mute",
     "tooltip": false,
     "scroll-step": 5,
     "on-click": "pavucontrol",
     "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
     "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+ -l 1.0",
     "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
  },

  "custom/actions-label": {
     "format": "ACCIONES",
     "tooltip": false
  },

  "custom/quick-settings": {
     "format": "󰒓",
     "tooltip": false,
     "on-click": "/home/zoro3435x/.config/waybar/scripts/quick-settings.sh"
  },

  "custom/network-settings": {
      "format": "󰤨",
      "tooltip": false,
      "on-click": "/home/zoro3435x/.config/waybar/scripts/network-menu.sh",
      "on-click-right": "nm-connection-editor"
  },

  "custom/clipboard": {
     "format": "",
     "tooltip": false,
     "on-click": "sh -c 'cliphist list | fuzzel --dmenu | cliphist decode | wl-copy'"
  },

  "custom/btop": {
      "format": "",
      "tooltip": false,
      "on-click": "kitty -e btop"
  },  

  "custom/lock": {
      "format": "󰌾",
      "tooltip": false,
      "on-click": "swaylock"
  },

  "custom/power": {
        "format": "⏻",
        "tooltip": false,
        "on-click": "wlogout"
  }
}
