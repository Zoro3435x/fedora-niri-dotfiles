{
    "layer": "top",
    "position": "right",
    "width": 86,

    "margin-top": 64,
    "margin-bottom": 16,
    "margin-right": 10,

    "spacing": 10,

    "modules-left": [
        "custom/avatar",
        "clock",
        "cpu",
        "memory",
        "temperature",
        "pulseaudio",
        "network"
    ],

    "modules-center": [],

    "modules-right": [
        "custom/network-settings",
        "custom/clipboard",
        "custom/btop",
        "custom/lock",
        "custom/power"
    ],

    "custom/avatar": {
        "format": "󰣇",
        "tooltip": false
    },

     "clock": {
        "format": "{:%H:%M}",
        "tooltip": true,
        "tooltip-format": "{:%A %d %B %Y}",
        "on-click": "/home/zoro3435x/.config/waybar/scripts/calendar-popup.sh"
   },
   "cpu": {
        "format": "\n{usage}%",
        "tooltip": false,
        "interval": 2
    },

    "memory": {
        "format": "\n{}%",
        "tooltip": false,
        "interval": 2
    },

    "temperature": {
        "format": "\n{temperatureC}°",
        "critical-threshold": 80,
        "tooltip": false
    },

    "pulseaudio": {
        "format": "\n{volume}%",
        "format-muted": "\nMute",
        "tooltip": false,
        "scroll-step": 5,
        "on-click": "pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+ -l 1.0",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
    },

    "network": {
        "format-wifi": "󰖩\nWiFi",
        "format-ethernet": "󰈀\nLAN",
        "format-disconnected": "󰖪\nOff",
        "tooltip": false,
        "on-click": "nm-connection-editor"
    },

    "custom/clipboard": {
        "format": "",
        "tooltip": false,
        "on-click": "sh -c 'cliphist list | fuzzel --dmenu | cliphist decode | wl-copy'"
    },

    "custom/btop": {
        "format": "",
        "tooltip": false,
        "on-click": "kitty -e btop"
    },

    "custom/lock": {
        "format": "󰌾",
        "tooltip": false,
        "on-click": "swaylock"
    },

    "custom/power": {
        "format": "⏻",
        "tooltip": false,
        "on-click": "wlogout"
    },
    "custom/network-settings": {
        "format": "󰖩",
        "tooltip": false,
        "on-click": "nm-connection-editor"
    },
}
