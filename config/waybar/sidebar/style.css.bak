* {
    font-family: "JetBrainsMono Nerd Font";
    font-size: 13px;
    font-weight: 700;
    border: none;
    min-height: 0;
}

window#waybar {
    background: transparent;
    color: #cdd6f4;
}

/* =========================
   BASE CARD STYLE
   ========================= */

#custom-avatar,
#clock,
#cpu,
#memory,
#temperature,
#pulseaudio,
#network,
#custom-clipboard,
#custom-btop,
#custom-lock,
#custom-power {
    background: rgba(17, 17, 27, 0.74);
    border: 1px solid rgba(203, 166, 247, 0.24);
    border-radius: 18px;
    padding: 12px 8px;
    margin: 0 8px;
    color: #cdd6f4;
}

/* =========================
   TOP AVATAR / LOGO
   ========================= */

#custom-avatar {
    color: #cba6f7;
    font-size: 28px;
    padding: 18px 8px;
    background: rgba(30, 30, 46, 0.78);
    border-color: rgba(203, 166, 247, 0.45);
}

/* =========================
   SYSTEM MODULES
   ========================= */

#clock {
    color: #cba6f7;
    font-size: 15px;
}

#cpu {
    color: #89b4fa;
}

#memory {
    color: #a6e3a1;
}

#temperature {
    color: #f9e2af;
}

#temperature.critical {
    color: #f38ba8;
}

#pulseaudio {
    color: #cba6f7;
}

#network {
    color: #89dceb;
}

/* =========================
   ACTION BUTTONS
   ========================= */
#custom-network-settings,
#custom-clipboard,
#custom-btop,
#custom-lock,
#custom-power {
    font-size: 20px;
    padding: 14px 8px;
}

#custom-clipboard {
    color: #89dceb;
}

#custom-btop {
    color: #a6e3a1;
}

#custom-lock {
    color: #f9e2af;
}

#custom-power {
    color: #f38ba8;
}

#custom-network-settings:hover,
#custom-clipboard:hover,
#custom-btop:hover,
#custom-lock:hover,
#custom-power:hover {
    background: rgba(203, 166, 247, 0.16);
    border-color: rgba(203, 166, 247, 0.55);
}
